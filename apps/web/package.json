{
  "name": "fdr-sentinel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4174",
    "typecheck": "tsc -b",
    "contracts": "openapi-typescript ../../openapi/openapi.json -o src/contracts.d.ts && prettier --write src/contracts.d.ts"
  },
  "dependencies": {
    "oidc-client-ts": "^3.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
